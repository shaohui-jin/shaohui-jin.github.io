{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.workflow.tsbuildinfo"
  },
  "include": [
    "src/works/workflow/**/*.ts",
    "src/works/workflow/**/*.vue",
    "src/global.d.ts",
    "src/env.d.ts"
  ]
}
