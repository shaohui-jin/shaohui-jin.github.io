{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.playground.tsbuildinfo",
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../comp/src/*"],
      "jsh-comp": ["../comp/src/index.ts"],
      "jsh-comp/doc": ["../comp/src/doc/index.ts"],
      "jsh-comp/doc/style/*": ["../comp/src/doc/style/*"],
      "jsh-comp/type": ["../comp/src/type/index.ts"],
      "jsh-comp/type/*": ["../comp/src/type/*"],
      "jsh-tool": ["../tool/src/index.ts"],
      "jsh-tool/doc": ["../tool/src/doc/index.ts"],
      "jsh-tool/*": ["../tool/src/*"],
      "jsh-core": ["../core/src/index.ts"],
      "jsh-core/doc": ["../core/src/doc/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.vue", "env.d.ts"],
  // vite.config.ts 是 node 侧代码（node:fs / node:path / IncomingMessage），
  // 本文件继承的是 @vue/tsconfig/tsconfig.dom.json，lib 只有 DOM 且没装
  // @types/node，硬塞进来必然报 TS2307。node 侧配置统一由根目录
  // tsconfig.node.json 覆盖，这里排除掉，免得 `pnpm build` 卡在类型检查。
  "exclude": ["vite.config.ts", "node_modules", "dist"]
}
